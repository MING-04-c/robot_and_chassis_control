# Function: One-shot motion mode switch request.
# Msg Name: SetMotionMode
# Maps to motion_mode_switch_cmd (0x110).
# Supported only when system_version_feedback.chassis_type_version is in
# currently defined all-wheel-steer chassis values: 0x61, 0x62, or 0x63.

uint8 MOTION_MODE_DEFAULT_CHASSIS = 0
uint8 MOTION_MODE_PARK = 1
uint8 MOTION_MODE_ACKERMANN = 2
uint8 MOTION_MODE_SPIN = 3
uint8 MOTION_MODE_LATERAL = 4
uint8 MOTION_MODE_DIAGONAL = 5

uint8 motion_mode
---
bool success
string message
